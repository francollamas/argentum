name: publish

on:
  push:
    branches: ['develop', 'main']

  workflow_dispatch:

defaults:
  run:
    working-directory: apps/client-pixi

env:
  CLIENT_DIR: apps/client-pixi
  ANDROID_NDK_VERSION: 27.0.11902837
  ANDROID_BUILD_TOOLS_VERSION: 34.0.0

jobs:
  prepare:
    name: Prepare release metadata
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.package-version.outputs.current-version }}
      release_tag: v${{ steps.package-version.outputs.current-version }}
      release_name: App v${{ steps.package-version.outputs.current-version }}
    steps:
      - uses: actions/checkout@v6

      - name: Get Node project version
        id: package-version
        uses: martinbeentjes/npm-get-version-action@v1.3.1
        with:
          path: ${{ env.CLIENT_DIR }}

  draft:
    name: Draft a release
    runs-on: ubuntu-latest
    needs: prepare
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v6

      - name: Draft
        uses: softprops/action-gh-release@v3
        with:
          draft: true
          name: ${{ needs.prepare.outputs.release_name }}
          tag_name: ${{ needs.prepare.outputs.release_tag }}
          generate_release_notes: true

  generate-assets:
    name: Generate client assets
    needs: prepare
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6

      - uses: ./.github/actions/setup-client
        with:
          working-directory: ${{ env.CLIENT_DIR }}

      - name: Generate assets
        run: pnpm run generate-assets

      - name: Upload generated assets
        uses: actions/upload-artifact@v7
        with:
          name: client-generated-assets
          path: |
            apps/client-pixi/src/assets
            apps/client-pixi/public/fonts

  publish-desktop:
    name: Publish desktop bundles
    needs:
      - prepare
      - draft
      - generate-assets
    permissions:
      contents: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - name: macos-arm64
            platform: 'macos-latest' # for Arm based macs (M1 and above).
            args: '--target aarch64-apple-darwin'
          - name: macos-x64
            platform: 'macos-latest' # for Intel based macs.
            args: '--target x86_64-apple-darwin'
          - name: linux-x64
            platform: 'ubuntu-22.04'
            args: '--target x86_64-unknown-linux-gnu'
          - name: windows-x64
            platform: 'windows-latest'
            args: ''

    runs-on: ${{ matrix.platform }}
    steps:
      - uses: actions/checkout@v6

      - uses: ./.github/actions/setup-client
        with:
          working-directory: ${{ env.CLIENT_DIR }}

      - name: install Rust stable
        if: ${{ matrix.platform == 'macos-latest' }}
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-apple-darwin,x86_64-apple-darwin

      - name: install Rust stable
        if: ${{ matrix.platform != 'macos-latest' }}
        uses: dtolnay/rust-toolchain@stable

      - name: install dependencies (ubuntu only)
        if: ${{ matrix.platform == 'ubuntu-22.04' }} # This must match the platform value defined above.
        run: |
          sudo apt-get update
          sudo apt-get install -y libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev patchelf

      - name: Download generated assets
        uses: actions/download-artifact@v8
        with:
          name: client-generated-assets
          path: apps/client-pixi

      - uses: tauri-apps/tauri-action@v0.6.2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          projectPath: apps/client-pixi
          tagName: v__VERSION__ # the action automatically replaces \_\_VERSION\_\_ with the app version.
          releaseName: 'App v__VERSION__'
          releaseDraft: true
          prerelease: false
          args: ${{ matrix.args }}

  publish-android:
    name: Publish Android bundle
    runs-on: ubuntu-latest
    needs:
      - prepare
      - draft
      - generate-assets
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v6

      - uses: ./.github/actions/setup-client
        with:
          working-directory: ${{ env.CLIENT_DIR }}

      - name: Setup Java
        uses: actions/setup-java@v5
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4

      - name: Install NDK
        run: sdkmanager "ndk;${{ env.ANDROID_NDK_VERSION }}"

      - name: install Rust stable
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-linux-android,armv7-linux-androideabi,i686-linux-android,x86_64-linux-android

      - name: Download generated assets
        uses: actions/download-artifact@v8
        with:
          name: client-generated-assets
          path: apps/client-pixi

      - name: Build app bundle
        run: pnpm tauri android build -v
        env:
          NDK_HOME: ${{ env.ANDROID_HOME }}/ndk/${{ env.ANDROID_NDK_VERSION }}

      - name: Extract android signing key from env
        run: |
          echo "${{ secrets.ANDROID_RELEASE_KEYSTORE }}" > src-tauri/gen/android/release.jks.base64
          base64 -d src-tauri/gen/android/release.jks.base64 > src-tauri/gen/android/release.decrypted.jks

      - name: Sign APK
        run: |
          ${{ env.ANDROID_HOME }}/build-tools/${{ env.ANDROID_BUILD_TOOLS_VERSION }}/apksigner sign --ks src-tauri/gen/android/release.decrypted.jks \
            --ks-key-alias ${{ secrets.ANDROID_RELEASE_KEY }} \
            --ks-pass pass:${{ secrets.ANDROID_RELEASE_PASSWORD }} \
            --key-pass pass:${{ secrets.ANDROID_RELEASE_KEY_PASSWORD }} \
            --out src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-signed.apk \
            src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-unsigned.apk

      - name: Rename APK file
        run: |
          mv ./src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release-signed.apk ./src-tauri/gen/android/app/build/outputs/apk/universal/release/argentum-${{ needs.prepare.outputs.version }}.apk

      - name: Publish
        uses: softprops/action-gh-release@v3
        with:
          draft: true
          name: ${{ needs.prepare.outputs.release_name }}
          tag_name: ${{ needs.prepare.outputs.release_tag }}
          generate_release_notes: true
          files: |
            apps/client-pixi/src-tauri/gen/android/app/build/outputs/apk/universal/release/argentum-${{ needs.prepare.outputs.version }}.apk
